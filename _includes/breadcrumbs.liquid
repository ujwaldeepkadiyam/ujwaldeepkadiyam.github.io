{% comment %}
Breadcrumbs Include for GitHub Pages
- Shows Home › Parent › Subpage › Current Page
- Works with parent hierarchy declared via front matter (`parent`) or collections
- Unordered list, no numbering
{% endcomment %}

{% assign crumbs = "" | split: "" %}

{%- comment -%}
Step 1: Find parent from front matter or collection mapping
{%- endcomment -%}
{% assign parent_title = page.parent %}
{% assign breadcrumb_collection = page.collection %}
{% if parent_title == nil and page.collection %}
  {% assign parent_title = site.breadcrumb_parents[page.collection] %}
{% endif %}

{%- comment -%}
Step 2: Walk up the parent chain (max 5 levels)
{%- endcomment -%}
{% for i in (1..5) %}
  {% if parent_title %}
    {% assign parent_page = site.pages | where: "title", parent_title | first %}
    {% if parent_page == nil and breadcrumb_collection == "teaching" %}
      {% assign parent_page = site.teaching | where: "title", parent_title | first %}
    {% endif %}
    {% if parent_page %}
      {% assign crumbs = crumbs | push: parent_page %}
      {% assign parent_title = parent_page.parent %}
    {% else %}
      {% assign parent_title = nil %}
    {% endif %}
  {% else %}
    {% break %}
  {% endif %}
{% endfor %}


<nav aria-label="breadcrumb" class="breadcrumbs">
  <ul style="list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:5px;">
    <li><a href="{{ '/' | relative_url }}">Home</a></li>
    {% for crumb in crumbs reversed %}
      <li>&nbsp;›&nbsp;<a href="{{ crumb.url | relative_url }}">{{ crumb.title }}</a></li>
    {% endfor %}
    <li>&nbsp;›&nbsp;{{ page.title }}</li>
  </ul>
</nav>


